# Squadz · Environment Configuration
# Copy to .env and fill in real values before running `docker compose up -d`.
# Never commit .env to git.

# Base domain (owned in Cloudflare for ACME DNS-01 TLS)
SQUADZ_DOMAIN=example.com

# Matrix homeserver & client discovery FQDN (serves Tuwunel, /.well-known/matrix/*, and /golive/*)
CHAT_FQDN=chat.example.com

# MatrixRTC / LiveKit FQDN (serves lk-jwt-service and LiveKit SFU signaling)
RTC_FQDN=rtc.example.com

# Host's mesh network IPv4 address (NordVPN Meshnet or Tailscale 100.x.y.z CGNAT IP).
# All published ports bind exclusively to this IP, and LiveKit advertises it as its ICE node_ip.
MESH_IP=100.64.0.1

# ACME account email for Let's Encrypt certificate expiry notices
ACME_EMAIL=admin@example.com

# Cloudflare API token with Zone:DNS:Edit permission for SQUADZ_DOMAIN
CLOUDFLARE_API_TOKEN=cf_token_replace_me

# LiveKit SFU API key pair (shared between livekit and lk-jwt-service)
# Generate with: openssl rand -hex 6 (key) and openssl rand -base64 32 (secret)
LIVEKIT_API_KEY=lk_key_replace_me
LIVEKIT_API_SECRET=lk_secret_replace_me_at_least_32_chars_long

# Secret token required for new Matrix account registration on Tuwunel
# Generate with: openssl rand -base64 24
TUWUNEL_REGISTRATION_TOKEN=reg_token_replace_me

# Admin Matrix account credentials (used by scripts/bootstrap.mjs to seed the Squadz Space)
SQUADZ_ADMIN_USER=aub
SQUADZ_ADMIN_PASSWORD=admin_password_replace_me

# Soundboard bot Matrix credentials and audio clips directory (used by bots/soundboard)
SOUNDBOARD_MATRIX_USER=soundboard
SOUNDBOARD_MATRIX_PASSWORD=soundboard_password_replace_me
SOUNDBOARD_CLIPS_DIR=./bots/soundboard/clips

# --- Mesh-only mode (written by `squadz setup --mesh-only`; leave unset for a real domain) ---
# SQUADZ_TLS=internal makes Caddy use its own CA instead of ACME DNS-01 (no Cloudflare token needed;
# then CLOUDFLARE_API_TOKEN may stay empty). COMPOSE_FILE must then include docker-compose.mesh.yml.
# SQUADZ_TLS=internal
# COMPOSE_FILE=docker-compose.yml:docker-compose.mesh.yml
